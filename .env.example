# SERVER ONLY. Copy to .env on the backend host, never to public assets.
HOST=127.0.0.1
PORT=8787
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FARIN_API_TOKEN=
# Empty = browser requests disabled. HTTPS origin only, without path or trailing slash.
# Do not embed FARIN_API_TOKEN in the dashboard even if CORS is enabled.
FARIN_ALLOWED_ORIGIN=
PAYAMGOSTAR_BASE_URL=https://farinroshan.cloud.payamgostar.com
PAYAMGOSTAR_USERNAME=
PAYAMGOSTAR_PASSWORD=
# REQUIRED before live reads: IRR = rial, IRT = toman. Confirm against your CRM.
PAYAMGOSTAR_CURRENCY=
# Optional CRM object type keys. Empty searches all accessible organizations / sale invoices / opportunities.
PAYAMGOSTAR_ORGANIZATION_TYPE_KEY=
PAYAMGOSTAR_INVOICE_TYPE_KEY=
PAYAMGOSTAR_OPPORTUNITY_TYPE_KEY=
# Exact ProductId -> service; use real CRM IDs, not inferred product name matching.
PAYAMGOSTAR_PRODUCT_SERVICE_MAP={}
# Exact StageId (lowercase GUID), or exact SaleStage text -> lead/review/proposal/won/lost.
PAYAMGOSTAR_STAGE_MAP={}
CRM_TIMEOUT_MS=15000
CRM_MAX_RECORDS=200
CRM_MAX_RESPONSE_BYTES=8388608
API_RATE_LIMIT=60
